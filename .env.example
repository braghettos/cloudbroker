# Application
APP_ENV=development
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cloudbroker
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/cloudbroker

# Alembic uses synchronous URL for migrations
# Use DATABASE_URL_SYNC when running: alembic upgrade head

# Security
# API_KEY: Required in production. In development, if not set, API key auth is bypassed.
# Generate a secure key: openssl rand -hex 32
# API_KEY=your-secret-api-key-here
# CORS_ORIGINS: Comma-separated list of allowed origins (e.g., "https://example.com,https://app.example.com")
# CORS_ORIGINS=
# RATE_LIMIT_PER_MINUTE: Rate limit per IP address (default: 100)
# RATE_LIMIT_PER_MINUTE=100

# Ingestion (optional)
# Hetzner: required for make ingest-hetzner
# HETZNER_API_TOKEN=
# GCP: use Application Default Credentials (gcloud auth application-default login)
#      OR set GOOGLE_APPLICATION_CREDENTIALS to path of service account JSON key file
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/gcp-service-account.json
# AWS: for ingest-aws, copy this file to .env and set the keys below (or use AWS profile).
# If set here, these take precedence over ~/.aws/credentials for the ingestor.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
# Azure: make ingest-azure uses Retail Prices API (no authentication required)
# DigitalOcean: required for make ingest-digitalocean
# DIGITALOCEAN_API_TOKEN=
# Scaleway: required for make ingest-scaleway
# SCALEWAY_ACCESS_KEY= or SCW_ACCESS_KEY=
# SCALEWAY_SECRET_KEY= or SCW_SECRET_KEY=
# UpCloud: required for make ingest-upcloud
# Option A: API token (recommended) - create at hub.upcloud.com/account/api-tokens
# UPCLOUD_API_TOKEN=
# Option B: username + password from workspace member with API access
# UPCLOUD_USERNAME=
# UPCLOUD_PASSWORD=
# Sustainability: real-time carbon intensity
#
# ENTSO-E: EU grid data. Free, requires token.
#   Register at https://transparency.entsoe.eu (email transparency@entsoe.eu)
# ENTSOE_TOKEN=
#
# EIA OpenData: US grid data. Free, requires API key.
#   Register at https://www.eia.gov/opendata/
# EIA_API_KEY=
#
# UK Carbon Intensity API: UK grid data. Free, no auth required (https://api.carbonintensity.org.uk)
# All UK region slugs (eu-west-2, uksouth, ukwest, lon1) are covered automatically.
#
# Static fallback: Ember Climate country-level averages are embedded in the service.
# No API key needed. Covers US, APAC, LatAm, MEA, and all countries without real-time data.
#
# Sustainability scoring knobs (optional, these are the defaults)
# SUSTAINABILITY_BOOST_MAX=0.15          # Max score boost when use_sustainability=True (15%)
# SUSTAINABILITY_CACHE_TTL_SECONDS=900   # Cache TTL in seconds (15 minutes)
# SUSTAINABILITY_CACHE_MAX_ENTRIES=500   # Max cache size (entries)

# Seeweb: required for make ingest-seeweb (API token preferred; or use username+password)
# SEEWEB_API_TOKEN=
# SEEWEB_USERNAME=
# SEEWEB_PASSWORD=
# OVH: required for make ingest-ovh
# OVH_APPLICATION_KEY= or OVH_AK=
# OVH_APPLICATION_SECRET= or OVH_AS=
# OVH_CONSUMER_KEY= or OVH_CK=
# OVH_SERVICE_NAME= or OVH_PROJECT_ID= (your Public Cloud project ID)

# Exoscale: required for make ingest-exoscale
# Generate at https://portal.exoscale.com/u/{org}/iam/api-keys
# EXOSCALE_API_KEY=
# EXOSCALE_API_SECRET=

# Aruba Cloud: required for make ingest-aruba
# Use your Aruba Cloud console credentials
# ARUBA_USERNAME=
# ARUBA_PASSWORD=
# ARUBA_DC_ID=1  # Data center: 1=Bergamo DC1, 2=Bergamo DC2, 3=Bergamo DC3

# IBM Cloud: required for make ingest-ibm-cloud
# Create API key at https://cloud.ibm.com/iam/apikeys
# IBMCLOUD_API_KEY=

# GCP machine types: fetched from Compute Engine API (requires google-cloud-compute package)
# Uses Application Default Credentials: run `gcloud auth application-default login`
# OR set GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id  # required for GCP machine types ingestion
